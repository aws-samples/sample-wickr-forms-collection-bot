        <mxCell id="cloud" value="AWS GovCloud (US-West)  --  us-gov-west-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;verticalAlign=top;align=left;spacing=10;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="1180" height="850" as="geometry" />
        </mxCell>

        <mxCell id="vpc" value="Spoke VPC  --  owned by the network team&#10;no internet gateway, no NAT gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;verticalAlign=top;align=left;spacing=8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="530" height="580" as="geometry" />
        </mxCell>
        <mxCell id="endpoints" value="VPC interface endpoints (optional)&#10;Bedrock, Transcribe (x2), Secrets Manager,&#10;CloudWatch Logs, ECR api + dkr&#10;443 from the task SG only.&#10;S3 gateway endpoint: network team provisions&#10;(requires route table changes they own)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#147EBA;verticalAlign=top;align=left;spacing=6;fontSize=9;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="140" width="490" height="95" as="geometry" />
        </mxCell>
        <mxCell id="privsubnet" value="Private subnets  --  no public IP; default route to Transit Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;verticalAlign=top;align=left;spacing=6;fontSize=11;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="410" y="250" width="490" height="410" as="geometry" />
        </mxCell>
        <mxCell id="tgw" value="Transit Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="1">
          <mxGeometry x="255" y="180" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="vdss" value="VDSS&#10;(DISA SCCA inspection)&#10;outbound incl. Wickr 443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#DD344C;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="75" y="175" width="150" height="65" as="geometry" />
        </mxCell>

        <!-- ============ Fargate task ============ -->
        <mxCell id="task" value="ECS Fargate task  --  1 vCPU / 2 GB  --  desiredCount 1&#10;egress-only SG: TCP 443, UDP 16384-16584" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;verticalAlign=top;align=left;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="440" height="350" as="geometry" />
        </mxCell>
        <mxCell id="wickriosvr" value="WickrIOSvr -notty&#10;spawns wickrio_bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="335" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nodebot" value="node bot.js  (Node.js 24.15.0)&#10;message-router  |  form-registry (11 forms)&#10;form-detector  |  extraction-engine&#10;delivery-service  |  transcription-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=11;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="425" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zmq" value="ZeroMQ IPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=classic;startArrow=classic;strokeColor=#ED7100;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="wickriosvr" target="nodebot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="opsnote" value="Credentials: AWS Secrets Manager, read once at startup by the entrypoint&#10;Logs: stdout/stderr -&gt; Amazon CloudWatch Logs (1 month retention)&#10;Entrypoint resolves Node.js via nvm and starts node directly (WPM is unreliable in -notty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=10;fontColor=#555555;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="535" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- ============ Right: AWS services ============ -->
        <mxCell id="bedrock" value="Amazon Bedrock  --  Converse API&#10;us-gov.anthropic.claude-sonnet-4-5&#10;swap model via BEDROCK_MODEL_ID" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1080" y="300" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="transcribe" value="Amazon Transcribe&#10;voice memos (batch jobs)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transcribe;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Amazon S3  --  reports bucket&#10;report JSON + transcription scratch (7d TTL)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1080" y="580" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="Amazon ECR&#10;pinned base image&#10;(console v6.66.2.1 / Node 24)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="1080" y="150" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- ============ Notes ============ -->
        <mxCell id="iamnote" value="IAM task role (least privilege)&#10;secretsmanager:GetSecretValue  -&gt;  single secret ARN&#10;bedrock:InvokeModel  -&gt;  foundation-model/* + inference-profile/*  (partition-aware)&#10;s3:Put/Get/DeleteObject  -&gt;  reports bucket only&#10;transcribe: 3 actions  (no resource-level support)&#10;ECS Exec  -&gt;  only when isDevelopmentEnv = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#DD344C;fontSize=10;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="700" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="flownote" value="Report flow&#10;1. text or voice memo in  (voice -&gt; Transcribe)&#10;2. Bedrock classifies the report type&#10;3. Bedrock extracts the form fields&#10;4. confirmation card -&gt; YES, or correction loop&#10;5. deliver per form definition: Wickr room + S3 + webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F6FF;strokeColor=#147EBA;fontSize=10;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="390" y="700" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="buildnote" value="Build and release&#10;bot/ tarball + Dockerfile  -&gt;  builder EC2 (SSM)&#10;-&gt;  docker build  -&gt;  ECR (immutable tag)&#10;-&gt;  CDK deploy (bin/, lib/)&#10;Deploys are stop-then-start: one bot login at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F6FF;strokeColor=#147EBA;fontSize=10;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="740" y="700" width="240" height="120" as="geometry" />
        </mxCell>

