        <mxCell id="title" value="Wickr Forms Collection Bot -- v2.0.0 (Bedrock Converse / Node.js 24) -- 2026-07-28" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#232F3E;align=left;" vertex="1" parent="1">
