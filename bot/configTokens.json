{
  "supportAdministrators": false,
  "supportVerification": false,
  "integration": "wickr-form-collection-bot",
  "tokens": [
    {
      "token": "AWS_REGION",
      "pattern": "",
      "type": "string",
      "description": "AWS region",
      "message": "AWS region for Bedrock, S3, and Transcribe",
      "required": true,
      "default": "us-east-1"
    },
    {
      "token": "BEDROCK_MODEL_ID",
      "pattern": "",
      "type": "string",
      "description": "Bedrock model ID",
      "message": "Bedrock model ID (us. prefix commercial, us-gov. GovCloud)",
      "required": true,
      "default": "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
    },
    {
      "token": "REPORTS_BUCKET",
      "pattern": "",
      "type": "string",
      "description": "Reports S3 bucket",
      "message": "S3 bucket for confirmed reports (blank to skip S3 delivery)",
      "required": false,
      "default": ""
    },
    {
      "token": "TRANSCRIPTION_S3_BUCKET",
      "pattern": "",
      "type": "string",
      "description": "Transcribe staging S3 bucket",
      "message": "S3 bucket for voice memo transcription (blank to disable)",
      "required": false,
      "default": ""
    },
    {
      "token": "TRANSCRIBE_POLL_TIMEOUT_MS",
      "pattern": "",
      "type": "string",
      "description": "Transcribe poll timeout in ms",
      "message": "Transcription timeout in ms (blank for default)",
      "required": false,
      "default": ""
    },
    {
      "token": "LOG_LEVEL",
      "pattern": "",
      "type": "string",
      "description": "Log level",
      "message": "Log level: DEBUG, INFO, WARN, or ERROR",
      "required": false,
      "default": "INFO"
    }
  ]
}
